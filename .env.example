# Example environment variables for local development
# Copy to .env and fill real secrets (do NOT commit .env to the repo)

# Database
DB_NAME=oficina_db
DB_USER=oficinampl
DB_PASSWORD=***REDACTED***
DB_PORT=5432

# Spring
SPRING_PROFILE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# JWT (dev only) - override in real envs
JWT_SECRET=***REDACTED***
JWT_EXPIRATION=3600

