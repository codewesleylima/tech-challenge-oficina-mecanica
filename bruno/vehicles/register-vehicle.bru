meta {
  name: Register Vehicle
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/vehicles/register
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "customerId": "{{customerId}}",
    "carLicensePlate": "ABC1D23",
    "model": "Civic",
    "manufacturer": "Honda",
    "kilometers": 50000,
    "year": 2020
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("vehicleId", res.body.vehicleId);
  }
}
