meta {
  name: Register Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/customers/register
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "João Silva",
    "email": "joao@email.com",
    "phone": "11999999999",
    "cpf": "12345678900"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("customerId", res.body.customerId);
  }
}
